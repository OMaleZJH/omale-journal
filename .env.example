# 只在部署平台（Netlify）的环境变量中设置。不要将真实密钥提交到仓库。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret
OWNER_EMAIL=your-login-email@example.com
OWNER_PASSWORD=use-a-long-unique-password
# 正式域名（可选）；RSS、站点地图和分享卡使用它生成绝对地址。
SITE_URL=https://omale-2030.netlify.app

# GitHub 一键登录（可选）。在 https://github.com/settings/developers 创建 OAuth App：
#   Homepage URL                填你的网站地址，如 https://omale.netlify.app
#   Authorization callback URL  填 https://你的域名/api/auth/github/callback
# 然后在 Netlify 环境变量中配置：
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
